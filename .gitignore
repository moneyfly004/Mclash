# ============================================================================
#  Mclash .gitignore
#  ⚠️ 注意：本项目从 Clash Mi 继承了一份 .gitignore，其中两条规则会误伤我们
#     需要的源码 —— 已在下方「不要忽略源码」段落显式排除：
#       · /lib/app/private   —— Mclash 的私有服务替代实现（必需源码）
#       · lib/generated/     —— build_time.dart 的静态兜底（未跑 build_runner 也能编译）
# ============================================================================

# ---------- 通用 ----------
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
*.hprof
/todo.txt

# ---------- IDE ----------
*.iml
*.ipr
*.iws
.idea/
/.idea/workspace.xml
/.vs
.vscode/

# ---------- Flutter / Dart ----------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/lib/generated_plugin_registrant.dart
app.*.symbols
app.*.map.json

# ---------- Android ----------
/android/app/build
/android/app/src/debug
/android/app/src/profile
/android/app/src/release
/android/.kotlin
/android/build

# ---------- 内核二进制（绝不入库） ----------
# Android：moneyfly004/mihomo-lib 的预编译 AAR（官方 MetaCubeX/mihomo 源码 +
# gomobile bind，约 185MB）。CI 构建时下载；本地用 tool/fetch_mihomo_aar.sh。
android/app/libs/*.aar
android/app/libs/*.jar
packages/libclash_vpn_service/android/libs/*.aar
# 下载中间产物也必须挡住。
#
# 踩过的坑：原有规则只写了 *.aar，而脚本的原子落位流程是「先下到
# libmihomo.aar.part → 校验 → mv 成 libmihomo.aar」。于是 .part 与
# libmihomo.aar.part.sha256 这两个**中间文件不在忽略范围内**：
#   · 下载进行中执行 git add -A，就把 81MB 的半成品提交了进去（已推到远端）；
#   · 下一次下载中途提交时更是到 161MB，超过 GitHub 单文件 100MB 上限，
#     push 被 pre-receive hook 直接拒绝。
# 所以按「所有 .part* 一律忽略」写，而不是只枚举具体文件名。
*.part
*.part.sha256
*.part.sha256sum
packages/libclash_vpn_service/android/libs/*.jar
# 桌面端内核（CI 下载官方预编译，本地用 tool/fetch_mihomo.sh）
mihomo-bin/
build/mihomo/

# 原 Clash Mi 的外置内核产物目录 bind/{android,windows,linux,apple/Libclash.xcframework}
# **已整体删除** —— Mclash 改用自有 AAR（Android）与官方 mihomo 二进制（桌面），
# 且桌面端不使用 NetworkExtension，因此不再需要 LibVpnCore / Libclash.xcframework。
# 见 docs/design/01 §1.6 与 08。

# ---------- 离线分流数据（CI 从 MetaCubeX/meta-rules-dat 下载） ----------
# 本地开发：bash tool/fetch_geodata.sh
assets/rules/*.dat
assets/rules/*.mmdb

# ---------- 签名与密钥（绝不入库） ----------
android/key.properties
*.keystore
*.jks
*.p12
*.pem
*.mobileprovision

# ---------- iOS ----------
ios/Mclashlib.xcframework/
ios/mclashWidget/VpnServiceHandler.swift
ios/PacketTunnel/country.mmdb
ios/PacketTunnel/geosite.dat
ios/build/
ios/Pods/
ios/.symlinks/

# ---------- macOS ----------
macos/Pods/
macos/Flutter/ephemeral/
macos/build/
macos/packaging/appdmg_make_config.json

# ---------- Windows / Linux ----------
windows/flutter/ephemeral/
windows/build/
*.vcxproj.user
linux/flutter/ephemeral/
linux/build/

# ---------- 打包与发布产物 ----------
/dist
/logs
/*.zip
/private

# ---------- 本地包（packages/*）的解析产物 ----------
packages/*/.dart_tool/
packages/*/build/
packages/*/pubspec.lock

# ---------- 运行期产物 ----------
/app.log
